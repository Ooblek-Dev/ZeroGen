{
  "name": "zerogen",
  "version": "5.0.0",
  "description": "ZeroGen v5 Final - Zero-Config Generation - 11 REAL Skills + E2E + Fullstack Dashboard - GitHub Ready",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:e2e": "npx playwright test --config=playwright.config.js",
    "dev": "npm run dev:fullstack",
    "dev:fullstack": "cd demo-fullstack && npm install && npm run dev",
    "build": "cd demo-fullstack && npm run build",
    "start": "cd demo-fullstack && npm start"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  },
  "engines": { "node": ">=20" },
  "keywords": ["zerogen", "github-action", "fullstack", "dashboard", "sbom", "e2e"]
}
